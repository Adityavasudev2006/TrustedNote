# Copy this file to `.env` in the same folder as config.py, then paste your key:
#   cp .env.example .env
#
# The pipeline reads `.env` automatically on every run. Change the key here only.

GROQ_API_KEY=

# Backend used by `python main.py` (groq | anthropic | local_hf | mock)
TRUSTNOTE_GEN_BACKEND=groq

# Groq model ID — see https://console.groq.com/docs/models
# llama-3.3-70b-versatile was retired for developer/free tiers — use one of:
GROQ_MODEL=openai/gpt-oss-20b

# Seconds to wait between Groq requests (use 60 for heavy batch / trustnote CLI)
# Seconds between Groq calls (15–20 recommended for long conversations)
GROQ_REQUEST_INTERVAL=20

# Speech-to-text for New session → Record (Groq Whisper API)
GROQ_WHISPER_MODEL=whisper-large-v3
# groq (default) or local (pip install faster-whisper, TRUSTNOTE_WHISPER_LOCAL_MODEL=base)
TRUSTNOTE_TRANSCRIBE_BACKEND=groq
